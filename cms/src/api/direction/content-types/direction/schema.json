{
  "kind": "collectionType",
  "collectionName": "directions",
  "info": {
    "singularName": "direction",
    "pluralName": "directions",
    "displayName": "География"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "country": {
      "type": "enumeration",
      "enum": [
        "cn",
        "kr",
        "jp"
      ],
      "required": true,
      "unique": true
    },
    "name": {
      "type": "string",
      "required": true
    },
    "tabText": {
      "type": "text",
      "required": true
    },
    "tabImage": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": [
        "images"
      ]
    },
    "description": {
      "type": "text",
      "required": true
    },
    "features": {
      "type": "component",
      "repeatable": true,
      "component": "shared.text-line"
    },
    "stats": {
      "type": "component",
      "repeatable": true,
      "component": "shared.stat"
    },
    "routes": {
      "type": "component",
      "repeatable": true,
      "component": "shared.route"
    },
    "order": {
      "type": "integer",
      "default": 0
    }
  }
}