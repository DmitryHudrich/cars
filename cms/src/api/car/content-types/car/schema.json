{
  "kind": "collectionType",
  "collectionName": "cars",
  "info": {
    "singularName": "car",
    "pluralName": "cars",
    "displayName": "Каталог"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "country": {
      "type": "enumeration",
      "enum": [
        "cn",
        "kr",
        "jp"
      ],
      "required": true
    },
    "price": {
      "type": "integer",
      "required": true
    },
    "specs": {
      "type": "string",
      "required": true
    },
    "image": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": [
        "images"
      ]
    },
    "priceDrop": {
      "type": "string"
    },
    "marketMin": {
      "type": "integer",
      "required": true
    },
    "marketMax": {
      "type": "integer",
      "required": true
    },
    "marketPosition": {
      "type": "decimal",
      "required": true,
      "min": 0,
      "max": 1
    },
    "marketLabel": {
      "type": "string",
      "required": true
    },
    "marketTone": {
      "type": "enumeration",
      "enum": [
        "up",
        "down"
      ],
      "required": true,
      "default": "up"
    },
    "order": {
      "type": "integer",
      "default": 0
    }
  }
}