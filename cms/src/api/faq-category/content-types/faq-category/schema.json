{
  "kind": "collectionType",
  "collectionName": "faq_categories",
  "info": {
    "singularName": "faq-category",
    "pluralName": "faq-categories",
    "displayName": "Разделы вопросов"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "label": {
      "type": "string",
      "required": true
    },
    "key": {
      "type": "enumeration",
      "enum": [
        "general",
        "warranty",
        "payment",
        "logistics",
        "docs",
        "check"
      ],
      "required": true,
      "unique": true
    },
    "icon": {
      "type": "enumeration",
      "enum": [
        "info",
        "shield",
        "card",
        "truck",
        "doc",
        "search"
      ],
      "required": true
    },
    "order": {
      "type": "integer",
      "default": 0
    },
    "items": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::faq-item.faq-item",
      "mappedBy": "category"
    }
  }
}